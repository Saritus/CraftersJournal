# Empaquetado para CurseForge (BigWigsMods/packager y tools/package.py): qué se
# publica y qué no.
package-as: CraftersJournal

# Notas de la versión que se ven en CurseForge
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tools
  - docs
  - dist
  - .github
  - "*.py"
  - "*.md"
  # Herramientas del desarrollador (/cj whatsnew): solo en su copia. Su línea del .toc
  # va dentro de #@do-not-package@, que el empaquetador quita
  - DevTools.lua
